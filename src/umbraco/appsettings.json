{
  "$schema": "appsettings-schema.json",
  "ConnectionStrings": {
    "umbracoDbDSN": "",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "Umbraco.Cms.Core.Services.LocalizedTextService": "Error"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "umbraco-cms"
    }
  },
  "Observability": {
    "ServiceName": "umbraco-cms",
    "ServiceNamespace": "demo-services",
    "DeploymentEnvironment": "demo",
    "Otlp": {
      "Endpoint": "http://localhost:4317",
      "Protocol": "grpc"
    }
  },
  "Demo": {
    "SlowEndpoint": false,
    "FaultEndpoint": false,
    "FaultRate": 0.1
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "Id": "205d667e-82e1-4f5a-98d1-0a5fee59912c",
        "UseHttps": false,
        "DefaultUILanguage": "en-US"
      },
      "DeliveryApi": {
        "Enabled": true,
        "PublicAccess": true
      },
      "Content": {
        "AllowEditInvariantFromNonDefault": true,
        "ContentVersionCleanupPolicy": {
          "EnableCleanup": true
        }
      },
      "Unattended": {
        "InstallUnattended": true,
        "InstallMissingDatabase": true,
        "UpgradeUnattended": true,
        "UnattendedTelemetryLevel": "Minimal"
      },
      "Security": {
        "AllowConcurrentLogins": false
      },
      "Imaging": {
        "HMACSecretKey": "vIPzfAwB2UQMJFeKJelffyYrp87aEotEHcv3ds8uGQcaT0YX30DSgi07Vq/rblko29cV7292xbdjoXhK1fCT2g=="
      }
    }
  }
}