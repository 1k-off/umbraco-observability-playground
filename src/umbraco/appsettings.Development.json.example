{
  "$schema": "appsettings-schema.json",
  "ConnectionStrings": {
    "umbracoDbDSN": "Server=10.255.0.101,1433;Database=Umbraco;User Id=sa;Password=REPLACE_ME;TrustServerCertificate=True;Encrypt=True"
  },
  "Observability": {
    "Otlp": {
