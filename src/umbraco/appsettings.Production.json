{
  "$schema": "appsettings-schema.json",
  "ConnectionStrings": {
    "umbracoDbDSN": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
              }
            }
          ]
        }
      }
    ]
  },
  "Demo": {
    "SlowEndpoint": false,
    "FaultEndpoint": false,
    "FaultRate": 0.1
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "UseHttps": true
      },
      "Hosting": {
        "Debug": true
      },
      "DeliveryApi": {
        "Enabled": true,
        "PublicAccess": true
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "https://demo-cms.1node.tech/"
      },
      "Unattended": {
        "InstallUnattended": false,
        "InstallMissingDatabase": false,
        "UpgradeUnattended": true,
        "UnattendedTelemetryLevel": "Minimal"
      }
    }
  }
}
