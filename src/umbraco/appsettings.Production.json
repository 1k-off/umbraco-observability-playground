{
  "$schema": "appsettings-schema.json",
  "ConnectionStrings": {
    "umbracoDbDSN": ""
  },
  "Observability": {
    "ServiceName": "umbraco-cms",
    "ServiceNamespace": "demo-services",
    "DeploymentEnvironment": "demo",
    "Otlp": {
      "Endpoint": "http://alloy-gateway.observability.svc.cluster.local:4317",
      "Protocol": "grpc"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "System": "Warning",
        "System.Net.Http.HttpClient": "Warning",
        "OpenTelemetry": "Warning",
        "Umbraco": "Warning",
        "Umbraco.Cms": "Warning",
        "Umbraco.Cms.Infrastructure": "Warning",
        "Umbraco.Cms.Core.Services.LocalizedTextService": "Error"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "service.name": "umbraco-cms"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console",
              "Args": {
                "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
              }
            }
          ]
        }
      }
    ]
  },
  "Demo": {
    "SlowEndpoint": false,
    "FaultEndpoint": false,
    "FaultRate": 0.1
  },
  "Umbraco": {
    "CMS": {
      "Global": {
        "UseHttps": true
      },
      "Hosting": {
        "Debug": false
      },
      "DeliveryApi": {
        "Enabled": true,
        "PublicAccess": true
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "https://demo-cms.1node.tech/"
      },
      "Unattended": {
        "InstallUnattended": false,
        "InstallMissingDatabase": false,
        "UpgradeUnattended": true,
        "UnattendedTelemetryLevel": "Minimal"
      }
    }
  }
}
