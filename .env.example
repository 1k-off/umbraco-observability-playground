# Copy to .env (gitignored) — local Docker Compose (apps in containers, SQL on remote K8s)

# CMS (Umbraco) — SQL Server in namespace sqlserver, external LB IP (remote cluster)
ConnectionStrings__umbracoDbDSN=Server=
ASPNETCORE_URLS=http://localhost:5000

# Demo feature flags
Demo__SlowEndpoint=false
Demo__FaultEndpoint=false

# Web (Next.js)
CMS_BASE_URL=http://localhost:5000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# k6
K6_WEB_BASE_URL=http://localhost:3000
K6_CMS_BASE_URL=http://localhost:5000

# Observability (Phase 6+)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=umbraco-web
FARO_COLLECTOR_URL=http://localhost:12347/collect
