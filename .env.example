# Copy to .env (gitignored) — local apps in containers; SQL on remote K8s (see deployment/k8s/sqlserver/)

# CMS (Umbraco) — Podman default port 8080 (see src/umbraco/README.md)
ConnectionStrings__umbracoDbDSN=Server=10.255.0.101,1433;Database=Umbraco;User Id=sa;Password=REPLACE_ME;TrustServerCertificate=True;Encrypt=True
ASPNETCORE_URLS=http://localhost:8080

# Demo feature flags
Demo__SlowEndpoint=false
Demo__FaultEndpoint=false

# Web (Next.js)
CMS_BASE_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# k6
K6_WEB_BASE_URL=http://localhost:3000
K6_CMS_BASE_URL=http://localhost:8080

# Observability (Phase 6+)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=umbraco-web
FARO_COLLECTOR_URL=http://localhost:12347/collect
