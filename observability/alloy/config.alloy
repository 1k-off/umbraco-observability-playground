// Phase 5 — OTLP gateway + Faro + profile ingest; forwards to Mimir, Loki, Tempo, Pyroscope.
// Deployed via deployment/k8s/observability/helm/values-alloy-gateway.yaml

logging {
  level  = "info"
  format = "logfmt"
}

// --- OTLP from apps (umbraco-cms, umbraco-web) ---

otelcol.receiver.otlp "gateway" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    metrics = [otelcol.processor.batch.otlp.input]
    logs    = [otelcol.processor.batch.otlp.input]
    traces  = [otelcol.processor.batch.otlp.input]
  }
}

otelcol.processor.batch "otlp" {
  output {
    metrics = [otelcol.exporter.prometheus.otlp.input]
    logs    = [otelcol.exporter.loki.otlp.input]
    traces  = [otelcol.exporter.otlp.tempo.input]
  }
}

otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "tempo.observability.svc.cluster.local:4317"
    tls {
      insecure             = true
      insecure_skip_verify = true
    }
  }
}

otelcol.exporter.loki "otlp" {
  forward_to = [loki.write.gateway.receiver]
}

otelcol.exporter.prometheus "otlp" {
  forward_to = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir-gateway.observability.svc.cluster.local/api/v1/push"
  }
}

loki.write "gateway" {
  endpoint {
    url = "http://loki-gateway.observability.svc.cluster.local/loki/api/v1/push"
  }
}

// --- Grafana Faro (browser RUM) ---

faro.receiver "browser" {
  server {
    listen_address = "0.0.0.0"
    listen_port    = 12347
    cors_allowed_origins = ["*"]
  }

  output {
    logs   = [loki.write.gateway.receiver]
    traces = [otelcol.exporter.otlp.faro_traces.input]
  }
}

otelcol.exporter.otlp "faro_traces" {
  client {
    endpoint = "tempo.observability.svc.cluster.local:4317"
    tls {
      insecure             = true
      insecure_skip_verify = true
    }
  }
}

// --- Continuous profiling (SDK push) ---

pyroscope.receive_http "apps" {
  http {
    listen_address = "0.0.0.0"
    listen_port    = 4041
  }

  forward_to = [pyroscope.write.gateway.receiver]
}

pyroscope.write "gateway" {
  endpoint {
    url = "http://pyroscope.observability.svc.cluster.local:4040"
  }
}
