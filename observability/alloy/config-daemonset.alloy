// Phase 5–7 — DaemonSet: pod logs (demo-services) + optional app scrape + kubelet cAdvisor.
// Deployed via deployment/k8s/observability/helm/values-alloy-daemonset.yaml (keep in sync).

logging {
  level  = "info"
  format = "logfmt"
}

discovery.kubernetes "pods" {
  role = "pod"

  namespaces {
    names = ["demo-services"]
  }
}

discovery.relabel "scrape_pods" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_scrape"]
    regex         = "true"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_port"]
    action        = "replace"
    target_label  = "__meta_kubernetes_pod_container_port_number"
    regex         = "(.+)"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_path"]
    action        = "replace"
    target_label  = "__metrics_path__"
    regex         = "(.+)"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label  = "service"
  }
}

prometheus.scrape "demo_apps" {
  targets    = discovery.relabel.scrape_pods.output
  forward_to = [prometheus.remote_write.mimir.receiver]
}

// --- Kubelet cAdvisor (container CPU/memory) via API proxy ---

discovery.kubernetes "nodes" {
  role = "node"
}

discovery.relabel "cadvisor" {
  targets = discovery.kubernetes.nodes.targets

  rule {
    action = "replace"
    target_label = "__address__"
    replacement  = "kubernetes.default.svc.cluster.local:443"
  }

  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    regex         = "(.+)"
    target_label  = "__metrics_path__"
    replacement   = "/api/v1/nodes/$1/proxy/metrics/cadvisor"
  }

  rule {
    source_labels = ["__meta_kubernetes_node_name"]
    target_label  = "node"
  }
}

prometheus.scrape "cadvisor" {
  targets         = discovery.relabel.cadvisor.output
  scheme          = "https"
  bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
  scrape_interval = "30s"
  scrape_timeout  = "10s"

  tls_config {
    ca_file              = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
    insecure_skip_verify = true
  }

  forward_to = [prometheus.relabel.demo_containers.receiver]
}

// Keep demo app (+ SQL) namespaces only — cut cardinality.
prometheus.relabel "demo_containers" {
  forward_to = [prometheus.remote_write.mimir.receiver]

  rule {
    source_labels = ["namespace"]
    regex         = "demo-services|sqlserver"
    action        = "keep"
  }

  // Drop short-lived / empty container ids noise
  rule {
    source_labels = ["container"]
    regex         = ""
    action        = "drop"
  }
}

// --- node-exporter + kube-state-metrics (observability ns) ---

discovery.kubernetes "obs_pods" {
  role = "pod"

  namespaces {
    names = ["observability"]
  }
}

discovery.relabel "cluster_exporters" {
  targets = discovery.kubernetes.obs_pods.targets

  // Keep only exporter metrics ports (SD already sets __address__ = podIP:port).
  rule {
    source_labels = [
      "__meta_kubernetes_pod_label_metrics_demo_scrape",
      "__meta_kubernetes_pod_container_port_number",
    ]
    separator = ";"
    regex     = "node-exporter;9100|kube-state-metrics;8080"
    action    = "keep"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_metrics_demo_scrape"]
    target_label  = "job"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_node_name"]
    target_label  = "node"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }
}

prometheus.scrape "cluster_exporters" {
  targets         = discovery.relabel.cluster_exporters.output
  scrape_interval = "30s"
  forward_to      = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir-gateway.observability.svc.cluster.local/api/v1/push"
  }
}

discovery.relabel "demo_pod_logs" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
}

loki.source.kubernetes "demo_pods" {
  targets    = discovery.relabel.demo_pod_logs.output
  forward_to = [loki.process.demo_pods.receiver]
}

// CMS: Serilog JSON with trace_id; web: plain Next.js logs (json stage is best-effort).
loki.process "demo_pods" {
  stage.drop {
    source              = "pod"
    expression          = "loki-canary.*"
    drop_counter_reason = "loki_canary"
  }

  // Next.js may log fsnotify errors on stderr in prod; not actionable for the demo.
  stage.drop {
    expression          = ".*fsnotify watcher.*"
    drop_counter_reason = "fsnotify_noise"
  }

  stage.json {
    expressions = {
      trace_id = "trace_id",
      TraceId  = "TraceId",
    }
  }

  forward_to = [loki.write.daemon.receiver]
}

loki.write "daemon" {
  endpoint {
    url = "http://loki-gateway.observability.svc.cluster.local/loki/api/v1/push"
  }
}
