// Phase 5 — DaemonSet: Prometheus scrape + Kubernetes pod logs (demo-services).
// Deployed via deployment/k8s/observability/helm/values-alloy-daemonset.yaml

logging {
  level  = "info"
  format = "logfmt"
}

discovery.kubernetes "pods" {
  role = "pod"

  namespaces {
    names = ["demo-services"]
  }
}

discovery.relabel "scrape_pods" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_scrape"]
    regex         = "true"
    action        = "keep"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_port"]
    action        = "replace"
    target_label  = "__meta_kubernetes_pod_container_port_number"
    regex         = "(.+)"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_path"]
    action        = "replace"
    target_label  = "__metrics_path__"
    regex         = "(.+)"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label  = "service"
  }
}

prometheus.scrape "demo_apps" {
  targets    = discovery.relabel.scrape_pods.output
  forward_to = [prometheus.remote_write.mimir.receiver]
}

prometheus.remote_write "mimir" {
  endpoint {
    url = "http://mimir-gateway.observability.svc.cluster.local/api/v1/push"
  }
}

discovery.relabel "demo_pod_logs" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label  = "service_name"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }
}

loki.source.kubernetes "demo_pods" {
  targets    = discovery.relabel.demo_pod_logs.output
  forward_to = [loki.process.demo_pods.receiver]
}

// CMS: Serilog JSON with trace_id; web: plain Next.js logs (json stage is best-effort).
loki.process "demo_pods" {
  stage.drop {
    source              = "pod"
    expression          = "loki-canary.*"
    drop_counter_reason = "loki_canary"
  }

  // Next.js may log fsnotify errors on stderr in prod; not actionable for the demo.
  stage.drop {
    expression          = ".*fsnotify watcher.*"
    drop_counter_reason = "fsnotify_noise"
  }

  stage.json {
    expressions = {
      trace_id = "trace_id",
      TraceId  = "TraceId",
    }
  }

  forward_to = [loki.write.daemon.receiver]
}

loki.write "daemon" {
  endpoint {
    url = "http://loki-gateway.observability.svc.cluster.local/loki/api/v1/push"
  }
}
