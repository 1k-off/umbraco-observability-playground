{
  "uid": "k8s-pod-resources",
  "title": "Kubernetes - Pod resources (demo)",
  "description": "Adapted from kube-mixin Compute Resources / Pod style panels. Requires Alloy cAdvisor scrape → Mimir (container_*).",
  "tags": ["demo", "kubernetes", "pod", "load-test"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-30m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Mimir", "value": "mimir" }
      },
      {
        "name": "namespace",
        "type": "custom",
        "query": "demo-services,sqlserver",
        "current": { "text": "demo-services", "value": "demo-services" },
        "includeAll": false
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\", container!=\"POD\"}, pod)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "CPU usage (cores)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", pod=~\"$pod\", container!=\"\", container!=\"POD\"}[5m]))",
          "legendFormat": "{{pod}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Memory working set",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (pod) (container_memory_working_set_bytes{namespace=\"$namespace\", pod=~\"$pod\", container!=\"\", container!=\"POD\"})",
          "legendFormat": "{{pod}}",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "CMS pod CPU (demo-umbraco)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"demo-services\", pod=~\"demo-umbraco.*\", container!=\"\", container!=\"POD\"}[5m]))",
          "legendFormat": "demo-umbraco",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CMS pod memory (demo-umbraco)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(container_memory_working_set_bytes{namespace=\"demo-services\", pod=~\"demo-umbraco.*\", container!=\"\", container!=\"POD\"})",
          "legendFormat": "working set",
          "datasource": { "type": "prometheus", "uid": "${datasource}" }
        }
      ]
    },
    {
      "id": 5,
      "type": "text",
      "title": "Notes",
      "gridPos": { "h": 3, "w": 24, "x": 0, "y": 16 },
      "options": {
        "mode": "markdown",
        "content": "Inspired by Kubernetes mixin **Compute Resources / Pod**. Metrics from Alloy `prometheus.scrape \"cadvisor\"` filtered to `demo-services|sqlserver`. If empty: apply `alloy/rbac-cadvisor.yaml`, upgrade Alloy DaemonSet, check `container_memory_working_set_bytes` in Explore."
      }
    }
  ]
}
